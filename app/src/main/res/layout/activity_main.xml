<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 4:5 Overlay -->
    <com.jonardca.pocomanualcam.AspectRatioOverlayView
        android:id="@+id/aspectOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/textureView"
        app:layout_constraintBottom_toBottomOf="@id/textureView"
        app:layout_constraintStart_toStartOf="@id/textureView"
        app:layout_constraintEnd_toEndOf="@id/textureView" />

    <!-- Center Crosshair -->
    <View
        android:id="@+id/crossVertical"
        android:layout_width="1.5dp"
        android:layout_height="36dp"
        android:background="#FFFFFFFF"
        app:layout_constraintTop_toTopOf="@id/textureView"
        app:layout_constraintBottom_toBottomOf="@id/textureView"
        app:layout_constraintStart_toStartOf="@id/textureView"
        app:layout_constraintEnd_toEndOf="@id/textureView" />

    <View
        android:id="@+id/crossHorizontal"
        android:layout_width="36dp"
        android:layout_height="1.5dp"
        android:background="#FFFFFFFF"
        app:layout_constraintTop_toTopOf="@id/textureView"
        app:layout_constraintBottom_toBottomOf="@id/textureView"
        app:layout_constraintStart_toStartOf="@id/textureView"
        app:layout_constraintEnd_toEndOf="@id/textureView" />

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="#CC000000"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnRatioGuide"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="3:4"
            android:textSize="11sp"
            android:backgroundTint="#555555"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnMotionTrack"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Track"
            android:textSize="11sp"
            android:backgroundTint="#555555"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp"
            android:enabled="false" />

        <Button
            android:id="@+id/btnAutoShutter"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Trap"
            android:textSize="11sp"
            android:backgroundTint="#555555"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp"
            android:enabled="false" />

        <Button
            android:id="@+id/btnFaceDetect"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Face"
            android:textSize="11sp"
            android:backgroundTint="#555555"
            android:textColor="#FFFFFF"
            android:enabled="false" />
    </LinearLayout>

    <!-- Controls (collapsible) -->
    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#CC000000"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar">

        <TextView
            android:id="@+id/toggleControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▲ Hide Controls"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="4dp"
            android:background="#33FFFFFF" />

        <LinearLayout
            android:id="@+id/seekBarsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:id="@+id/isoLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ISO: Auto" android:textColor="#FFFFFF" android:textSize="12sp" />
            <SeekBar android:id="@+id/isoSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:tickMark="@drawable/tick_mark" android:tickMarkTint="#88FFFFFF" />

            <TextView android:id="@+id/shutterLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shutter: Auto" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginTop="4dp" />
            <SeekBar android:id="@+id/shutterSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:tickMark="@drawable/tick_mark" android:tickMarkTint="#88FFFFFF" />

            <TextView android:id="@+id/focusLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Focus: Auto" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginTop="4dp" />
            <SeekBar android:id="@+id/focusSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:tickMark="@drawable/tick_mark" android:tickMarkTint="#88FFFFFF" />

            <TextView android:id="@+id/wbLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WB: Auto" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginTop="4dp" />
            <SeekBar android:id="@+id/wbSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="31" android:tickMark="@drawable/tick_mark" android:tickMarkTint="#88FFFFFF" />

            <TextView android:id="@+id/evLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EV: 0" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginTop="4dp" />
            <SeekBar android:id="@+id/evSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="48" android:tickMark="@drawable/tick_mark" android:tickMarkTint="#88FFFFFF" />

            <TextView android:id="@+id/zoomLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zoom: 1.0x" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginTop="4dp" />
            <SeekBar android:id="@+id/zoomSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:tickMark="@drawable/tick_mark" android:tickMarkTint="#88FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#CC000000"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/ratioButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:text="3:4"
            android:backgroundTint="#666666"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/captureButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="CAPTURE"
            android:backgroundTint="#FF5722"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/galleryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GALLERY"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
